# ===================================================
# RUPKATHA SAREES — FRONTEND ENV CONFIGURATION
# ===================================================

# API
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Rupkatha Sarees

# Razorpay (Public Key only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Google OAuth (for NextAuth.js integration)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Cloudinary (for direct frontend uploads if needed)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=rupkatha_unsigned

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Feature Flags
NEXT_PUBLIC_ENABLE_WHATSAPP=true
NEXT_PUBLIC_ENABLE_LOYALTY=true
NEXT_PUBLIC_ENABLE_AI_RECOMMENDATIONS=false

# Currency
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
